{{!-- Recent posts teaser instead of the full paginated archive --}}
{{#get "posts" filter="authors:[{{slug}}]" limit="4" order="published_at desc" as |recent_posts|}}
{{#if recent_posts}}
<section class="author-recent container mx-auto py-vmin8">
    <div class="author-recent-header flex items-center justify-between mb-8">
        <h2 class="text-32 text-title">{{t "Recent posts"}}</h2>
        <a href="{{@site.url}}/notebook/" class="link is-hover font-medium">{{t "See all in Notebook"}}<svg class="icon is-medium"><use xlink:href="#icon-arrow"></use></svg></a>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {{#foreach recent_posts}}
            {{> "story/story-card-small"}}
        {{/foreach}}
    </div>
</section>
{{/if}}
{{/get}}

{{/author}}

{{#contentFor "scripts"}}
<script>
(function () {
    var toggle = document.querySelector('.js-gpg-toggle');
    var panel = document.getElementById('author-gpg-panel');
    if (!toggle || !panel) return;

    toggle.addEventListener('click', function () {
        var expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        panel.classList.toggle('hidden');
    });

    var copyBtn = document.querySelector('.js-gpg-copy');
    var keyText = document.getElementById('author-gpg-key-text');
    if (!copyBtn || !keyText) return;

    copyBtn.addEventListener('click', function () {
        var text = keyText.textContent;

        var done = function () {
            copyBtn.textContent = copyBtn.getAttribute('data-label-done');
            setTimeout(function () {
                copyBtn.textContent = copyBtn.getAttribute('data-label');
            }, 1800);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done);
        } else {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            try { document.execCommand('copy'); } catch (e) {}
            document.body.removeChild(ta);
            done();
        }
    });
})();
</script>
{{/contentFor}}
