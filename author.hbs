{{!< default}}
{{!-- The tag above means - insert everything in this file into the {body} of the default.hbs template --}}

{{#author}}

{{!-- custom Styles For tag <body> --}}
{{#contentFor "special_body_class"}}is-author{{#if cover_image}} has-cover is-head-transparent{{/if}}{{/contentFor}}

<section class="author-hero relative overflow-hidden{{#if cover_image}} has-photo{{/if}}">
    {{#if cover_image}}
    <div class="author-hero-photo absolute inset-0">
        {{!-- Featured Media - partials/components/media-cover.hbs --}}
        {{> "components/media-cover" background=cover_image has_gradient=true alt_title=name}}
    </div>
    {{/if}}

    <div class="author-hero-grid container mx-auto relative z-2 py-vmin8{{#if cover_image}} cover-text{{/if}}">
        {{!-- Avatar + stat rail --}}
        <div class="author-hero-identity">
            <figure class="author-avatar-frame">
                <img class="author-avatar"
                    src="{{#if profile_image}}{{img_url profile_image size="s"}}{{else}}{{asset "images/avatar.png"}}{{/if}}"
                    alt="{{t "Hi I'm"}} {{name}}"
                    width="168" height="168"
                />
            </figure>

            <dl class="author-stat-rail">
                <div class="author-stat">
                    <dt>{{t "Posts"}}</dt>
                    <dd>{{../pagination.total}}</dd>
                </div>

                {{#get "posts" filter="authors:[{{slug}}]" limit="1" order="published_at asc" as |first_post|}}
                {{#foreach first_post}}
                <div class="author-stat">
                    <dt>{{t "Since"}}</dt>
                    <dd>{{date published_at format="YYYY"}}</dd>
                </div>
                {{/foreach}}
                {{/get}}

                {{#if location}}
                <div class="author-stat">
                    <dt>{{t "Based in"}}</dt>
                    <dd>{{location}}</dd>
                </div>
                {{/if}}
            </dl>
        </div>

        {{!-- Name, bio, links --}}
        <div class="author-hero-content">
            <h1 class="author-name">{{name}}</h1>

            {{#if bio}}<p class="author-bio">{{bio}}</p>{{/if}}

            <div class="author-links">
                {{#if website}}
                <a href="{{website}}" class="author-link" target="_blank" rel="noopener noreferrer">
                    <svg class="icon is-stroke"><use xlink:href="#icon-link"></use></svg>
                    <span>{{website}}</span>
                </a>
                {{/if}}

                <a href="https://feedly.com/i/subscription/feed/{{url absolute="true"}}rss/" class="author-link" target="_blank" rel="noopener noreferrer">
                    <svg class="icon"><use xlink:href="#icon-rss"></use></svg>
                    <span>{{t "Subscribe"}}</span>
                </a>

                {{#match slug "pavel"}}
                <button type="button" class="author-link js-gpg-toggle" aria-expanded="false" aria-controls="author-gpg-panel">
                    <svg class="icon"><use xlink:href="#icon-checkmark"></use></svg>
                    <span>{{t "GPG Key"}}</span>
                </button>
                {{/match}}
            </div>

            {{#match slug "pavel"}}
            <p class="author-gpg-fingerprint"><span class="author-gpg-fingerprint-label">{{t "GPG fingerprint"}}</span>14B1 DFFB E91C 4DAD B3DE&nbsp; A1B9 944E E299 2764 56C7</p>

            <div id="author-gpg-panel" class="author-gpg-panel hidden">
                <div class="author-gpg-panel-toolbar">
                    <span class="author-gpg-panel-label">{{t "Public key"}}</span>
                    <button type="button" class="author-gpg-copy js-gpg-copy" data-label="{{t "Copy"}}" data-label-done="{{t "Copied"}}">{{t "Copy"}}</button>
                </div>
