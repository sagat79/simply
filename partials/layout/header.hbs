<header class="header js-header h-16 w-full text-sm flex items-center sticky top-0 z-20">
    <div class="header-wrap mx-auto flex items-center flex-auto px-4 w-full max-w-extreme">
        {{!-- Logo --}}
        <div class="header-left mr-5 flex flex-none items-center">
            <a href="{{@site.url}}"
                class="header-logo inline-block leading-none tracking-event"
                data-event-category="Header"
                data-event-action="Logo"
                data-event-label="Click"
                data-event-non-interaction="true">
                {{#if @site.logo}}
                    {{!-- Dark-mode logo swap moved off config.custom (package.json was at Ghost's
                         hard 20-setting limit, freed here for show_cookie_notice below) to a fixed
                         theme asset -- toggle this literal alongside the matching one in
                         partials/layout/footer-dark.hbs, they must stay in sync. --}}
                    {{#if true}}
                        <img src="{{@site.logo}}" class="header-logo-img max-h-9 logo-default" alt="{{@site.title}}"/>
                        <img src="{{asset "images/logo-dark.svg"}}" class="header-logo-img max-h-9 hidden logo-dark-mode" alt="{{@site.title}}"/>
                    {{else}}
                        <img src="{{@site.logo}}" class="header-logo-img max-h-9" alt="{{@site.title}}"/>
                    {{/if}}
                {{else}}
                    <span class="text-3xl font-bold text-logo">{{@site.title}}</span>
                {{/if}}
            </a>
        </div>

        {{!-- Navigation --}}
        {{#if @site.navigation}}
            {{#if hasDropDown}}
                {{navigation navigationDropDown=true}}
            {{else}}
                {{navigation}}
            {{/if}}
        {{/if}}

        <div class="header-right flex-none flex justify-end items-center">
            {{!-- Light and Dark Mode --}}
            <button type="button" class="js-dark-mode button is-white items-center mr-2" aria-label="Dark and Light Mode">
                <svg class="icon icon--moon m-0" style="margin-right:calc(-0.5em - 1px)"><use xlink:href="#icon-moon"></use></svg>
                <svg class="icon icon--sunny m-0 hidden" style="margin-left:calc(-0.5em - 1px)"><use xlink:href="#icon-sunny"></use></svg>
            </button>

            {{!-- Toggle Searcg --}}
            <a href="#/search"
                role="button"
                aria-label="Toggle Search"
                class="tracking-event button is-white mr-2"
                aria-haspopup="true"
                data-event-category="Header"
                data-event-action="Search"
                data-event-label="Click"
                data-event-non-interaction="true"
                data-ghost-search>
                <svg class="icon icon--search"><use xlink:href="#icon-search"></use></svg>
            </a>

            {{!-- Menu User Account --}}
            {{#if @site.members_enabled}}{{> "layout/account-menu"}}{{/if}}

            {{!-- Toggle Menu --}}
            <button type="button" aria-label="Show Navigation Menu" class="js-menu-toggle menu-burger button is-white relative lg:hidden"><span></span><span></span><span></span></button>
        </div>
    </div>
</header>

