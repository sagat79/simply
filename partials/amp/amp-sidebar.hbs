<amp-sidebar id="sidenav" class="sidebar flex flex-col" layout="nodisplay" side="right">
    <div class="sidebar-header h-16 flex justify-between items-center px-4 text-gray-500">
        <div class="text-lg">{{t "Menu"}}</div>
        <div class="close-sidebar" role="button" aria-label="close sidebar" on="tap:sidenav.close" tabindex="0">✕</div>
    </div>

    {{!-- Navigation --}}
    <div class="flex-auto">
        {{#if @site.navigation}}{{navigation navigationMobile=true}}{{/if}}
    </div>

    {{!-- Social media --}}
    <div class="social-media px-4">
        {{#if @site.facebook}}
            <a href="{{social_url type="facebook"}}" target="_blank" rel="noopener noreferrer">{{> "amp/icon-facebook"}}</a>
        {{/if}}

        {{#if @site.x}}
            <a href="{{social_url type="x"}}" target="_blank" rel="noopener noreferrer">{{> "amp/icon-x"}}</a>
        {{/if}}

        {{#if @site.threads}}
            <a href="{{social_url type="threads"}}" target="_blank" rel="noopener noreferrer">{{> "amp/icon-threads"}}</a>
        {{/if}}

        {{#if @site.bluesky}}
            <a href="{{social_url type="bluesky"}}" target="_blank" rel="noopener noreferrer">{{> "amp/icon-bluesky"}}</a>
        {{/if}}

        {{#if @site.mastodon}}
            <a href="{{social_url type="mastodon"}}" target="_blank" rel="noopener noreferrer">{{> "amp/icon-mastodon"}}</a>
        {{/if}}

        {{#if @site.tiktok}}
            <a href="{{social_url type="tiktok"}}" target="_blank" rel="noopener noreferrer">{{> "amp/icon-tiktok"}}</a>
        {{/if}}

        {{#if @site.instagram}}
            <a href="{{social_url type="instagram"}}" target="_blank" rel="noopener noreferrer">{{> "amp/icon-instagram"}}</a>
        {{/if}}

        {{#if @site.youtube}}
            <a href="{{social_url type="youtube"}}" target="_blank" rel="noopener noreferrer">{{> "amp/icon-youtube"}}</a>
        {{/if}}

        {{#if @site.telegram}}
            <a href="{{social_url type="telegram"}}" target="_blank" rel="noopener noreferrer">{{> "amp/icon-telegram"}}</a>
        {{/if}}

        {{#if @site.snapchat}}
            <a href="{{social_url type="snapchat"}}" target="_blank" rel="noopener noreferrer">{{> "amp/icon-snapchat"}}</a>
        {{/if}}

            </div>

</amp-sidebar>
