{
  "name": "simply",
  "description": "Simply theme for Ghost, originally created by @GodoFredoNinja – modified and extended by @sagat79",
  "demo": "https://godofredo.ninja",
  "version": "2025.13.7",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "GPL-3.0-or-later",
  "screenshots": {
    "desktop": "screenshot.jpg"
  },
  "author": {
    "name": "GodoFredo",
    "email": "hello@godofredo.ninja",
    "url": "https://godofredo.ninja"
  },
  "gpm": {
    "type": "theme",
    "categories": [
      "Minimal",
      "Magazine",
      "Blog"
    ]
  },
  "keywords": [
    "ghost",
    "theme",
    "ghost-theme",
    "GodoFredoNinja"
  ],
  "features": {
    "customFonts": true,
    "i18n": true
  },
  "languages": {
    "en": "English",
    "bg": "Български",
    "ko": "한국어",
    "np": "नेपाली",
    "hr": "Hrvatski"
  },
  "customFonts": {
    "title": {
      "name": "Title Font",
      "description": "Font used for titles and headings",
      "default": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif"
    },
    "body": {
      "name": "Body Font",
      "description": "Font used for body text",
      "default": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/godofredoninja/simply"
  },
  "bugs": {
    "url": "https://github.com/godofredoninja/simply/issues",
    "email": "hello@godofredo.ninja"
  },
  "config": {
    "posts_per_page": 18,
    "image_sizes": {
      "xxs": {
        "width": 30
      },
      "xs": {
        "width": 100
      },
      "s": {
        "width": 300
      },
      "m": {
        "width": 600
      },
      "l": {
        "width": 1000
      },
      "xl": {
        "width": 2000
      }
    },
    "card_assets": {
      "exclude": [
        "bookmark",
        "blockquote"
      ]
    },
    "custom": {
      "header": {
        "type": "select",
        "options": [
          "Default",
          "Drop Down Menu"
        ],
        "default": "Default"
      },
      "footer": {
        "type": "select",
        "options": [
          "Default",
          "Dark",
          "No Secondary Navigation"
        ],
        "default": "Default"
      },
      "color_scheme": {
        "type": "select",
        "options": [
          "Light",
          "Dark",
          "Auto"
        ],
        "default": "Auto"
      },
      "logo_dark": {
        "type": "image"
      },
      "pagination": {
        "type": "select",
        "options": [
          "Infinite Scroll",
          "Pagination Number"
        ],
        "default": "Infinite Scroll"
      },
      "story_meta": {
        "type": "select",
        "options": [
          "Author",
          "Read More"
        ],
        "default": "Author"
      },
      "publication_cover": {
        "type": "select",
        "options": [
          "None",
          "Featured",
          "Featured Slider",
          "Cover"
        ],
        "default": "Cover",
        "group": "homepage"
      },
      "publication_cover_title": {
        "type": "text",
        "group": "homepage"
      },
      "publication_cover_description": {
        "type": "text",
        "group": "homepage"
      },
      "publication_cover_color": {
        "type": "color",
        "default": "#ffffff",
        "group": "homepage"
      },
      "publication_cover_img": {
        "type": "image",
        "group": "homepage"
      },
      "post_font": {
        "type": "select",
        "options": [
          "font-sans",
          "font-serif"
        ],
        "default": "font-serif",
        "group": "post"
      },
      "show_newsletter": {
        "type": "boolean",
        "default": false,
        "group": "post"
      },
      "show_prev_and_next_post": {
        "type": "boolean",
        "default": true,
        "group": "post"
      },
      "newsletter_text": {
        "type": "text",
        "default": "Sign up for more like this",
        "group": "post"
      },
      "show_announcement": {
        "type": "boolean",
        "default": false
      },
      "announcement_config": {
        "type": "text",
        "default": "{\"text\":\"\",\"link\":\"\",\"button_text\":\"\"}"
      },
      "announcement_style": {
        "type": "select",
        "options": [
          "primary",
          "black",
          "white",
          "gray-100",
          "gray-900"
        ],
        "default": "primary"
      },
      "announcement_text_color": {
        "type": "select",
        "options": [
          "white",
          "black",
          "gray-900",
          "gray-100"
        ],
        "default": "white"
      },
      "announcement_closeable": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "browserslist": [
    "defaults"
  ],
  "cssnano": {
    "preset": [
      "advanced",
      {
        "reduceIdents": false
      }
    ]
  },
  "scripts": {
    "build": "gulp build",
    "prod": "cross-env NODE_ENV=production gulp production --production",
    "dev": "gulp development",
    "lint:js": "standard src/js/**/*.js gulpfile.js",
    "lint:css": "stylelint src/css/**/*.css",
    "lint": "yarn lint:js && yarn lint:css",
    "test": "yarn lint && gscan .",
    "scan": "gscan .",
    "deploy": "gulp deploy"
  },
  "devDependencies": {
    "@babel/core": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.18.6",
    "@babel/preset-env": "^7.18.6",
    "@babel/runtime": "^7.18.6",
    "@tailwindcss/line-clamp": "^0.4.0",
    "@tailwindcss/typography": "^0.5.4",
    "@tryghost/admin-api": "^1.13.2",
    "autoprefixer": "^10.4.7",
    "babelify": "^10.0.0",
    "beeper": "^3.0.0",
    "browserify": "^17.0.0",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.0",
    "cssnano-preset-advanced": "^7.0.0",
    "del": "^6.1.1",
    "dotenv": "^16.0.3",
    "gscan": "^6.4.2",
    "gulp": "^5.0.1",
    "gulp-header": "^2.0.9",
    "gulp-if": "^3.0.0",
    "gulp-livereload": "^4.0.2",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.3",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-strip-comments": "^2.5.2",
    "gulp-uglify": "^3.0.2",
    "gulp-zip": "^6.0.0",
    "merge-stream": "^2.0.0",
    "postcss": "^8.4.14",
    "postcss-discard-comments": "^7.0.0",
    "postcss-extend": "^1.0.5",
    "postcss-import": "^15.1.0",
    "postcss-nested": "^7.0.0",
    "postcss-scss": "^4.0.9",
    "precss": "^4.0.0",
    "prettier": "^3.5.3",
    "pump": "^3.0.0",
    "standard": "^17.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-css-modules": "^4.4.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recommended": "^16.0.0",
    "stylelint-config-recommended-scss": "^15.0.1",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-order": "^7.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^6.12.0",
    "vinyl-buffer": "^1.0.1",
    "vinyl-source-stream": "^2.0.0"
  },
  "dependencies": {
    "infinite-scroll": "^5.0.0",
    "medium-zoom": "^1.0.6",
    "normalize.css": "^8.0.1",
    "prismjs": "^1.30.0",
    "tailwindcss": "^3.4.17",
    "tiny-slider": "^2.9.4"
  }
}
