{{!-- Layout --}}
{{!< default}}

{{#post}}

{{!-- Class for <body> --}}
{{#contentFor "special_body_class"}}is-article{{/contentFor}}

<article class="post py-vmin8 relative">
    <header class="post-header content-canvas">
        <h1 class="post-title text-32 md:text-4xl lg:text-44 text-title leading-tight">{{title}}</h1>
        {{#if custom_excerpt}}<p class="post-excerpt mt-6 text-22 text-gray-500">{{custom_excerpt}}</p>{{/if}}

        {{!-- Deliverable #4 of the GDPR pass: auto-generated so it can never go stale
        the way a hand-typed date in the page content can (and did, for /cookie/).
        Slug-gated to the three legal pages only -- repeated per-slug rather than a
        single OR check, matching this theme's own established pattern for slug-only
        content (see author.hbs's `{{#match slug "pavel"}}` blocks).
        No "Effective Date" line: privacy-policy and cookie are pre-existing Ghost
        pages (published_at dates back to 2021, long before this GDPR rewrite), so
        published_at doesn't actually track when this policy text took effect --
        only updated_at (last edit) is reliably accurate for all three pages. --}}
        {{#match slug "privacy-policy"}}
        <p class="post-legal-dates mt-4 text-sm text-gray-500">{{t "Last Updated"}}: {{date updated_at format="MMMM D, YYYY"}}</p>
        {{/match}}
        {{#match slug "cookie"}}
        <p class="post-legal-dates mt-4 text-sm text-gray-500">{{t "Last Updated"}}: {{date updated_at format="MMMM D, YYYY"}}</p>
        {{/match}}
        {{#match slug "terms-of-service"}}
        <p class="post-legal-dates mt-4 text-sm text-gray-500">{{t "Last Updated"}}: {{date updated_at format="MMMM D, YYYY"}}</p>
        {{/match}}
    </header>

    <section id="post-body" class="post-body content-canvas mx-auto relative {{#match @custom.post_font "=" "font-serif"}}font-serif{{else}}font-sans{{/match}}">
        {{!-- Post Image - partials/article/article-featured-image.hbs --}}
        {{#if feature_image}}{{> "article/article-featured-image" image=feature_image class="kg-width-wide"}}{{/if}}

        {{content}}

        {{!-- Table of Content --}}
        <div class="content-side top-0 bottom-0 absolute pr-8 row-start-1 hidden font-sans lg:block">
            <div class="sticky top-20 overflow-auto scroll-transparent lg:max-h-(screen-16)">
                <div class="js-tocbot text-base space-y-4 leading-tight"></div>
            </div>
        </div>
    </section>
</article>

{{/post}}

{{#contentFor "scripts"}}
<script>
function buildTocLinks() {
  var $markdown = document.querySelector('.post-body');
  if (!$markdown) return;

  var $titles = $markdown.querySelectorAll('h2[id]');

  if (!$titles.length) return;

  var $jsTocBot = document.querySelector('.js-tocbot');

  $titles.forEach(function (el) {
    var titleLink = document.createElement('a');
    titleLink.href = '#' + el.getAttribute('id');
    titleLink.textContent = el.textContent;
    titleLink.classList = 'text-gray-500 block !no-underline hover:text-gray-900';

    $jsTocBot.appendChild(titleLink);
  });
};

document.addEventListener('DOMContentLoaded', buildTocLinks);
</script>
{{/contentFor}}